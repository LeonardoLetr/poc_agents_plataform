{
  "name": "agent-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma visual para estudar agentes autônomos: loop de raciocínio, ferramentas, MCP, memória e auditoria.",
  "workspaces": [
    "core",
    "web",
    "mcp-mercados"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "preview": "npm run preview -w web",
    "typecheck": "npm run typecheck -w web && npm run typecheck -w mcp-mercados",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "mercados": "npm start -w mcp-mercados"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
